{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:payflow:contract:RiskAssessed:v1",
  "title": "RiskAssessed v1",
  "description": "",
  "x-topic": "fraud.events",
  "x-producer": "fraud-service",
