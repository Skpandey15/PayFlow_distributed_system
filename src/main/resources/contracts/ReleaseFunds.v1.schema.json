{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:payflow:contract:ReleaseFunds:v1",
  "title": "ReleaseFunds v1",
  "description": "",
  "x-topic": "funds.commands",
  "x-producer": "payment-service",
  "type": "object",
  "required": [
    "paymentId",
    "payerAccountId",
    "amount",
    "currency",
    "reason"
  ],
  "properties": {
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "payerAccountId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
      "description": "Decimal string; never a JSON number"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
