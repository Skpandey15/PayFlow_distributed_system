# Copy to .env (git-ignored) and replace EVERY value. These are local-development credentials only.
# In Kubernetes (later WPs) the same variables come from Secrets / an external secret manager.
POSTGRES_SUPERUSER_PASSWORD=change-me-pg-superuser
PAYFLOW_DB_MIGRATION_PASSWORD=change-me-migrator
PAYFLOW_DB_PASSWORD=change-me-app
PAYFLOW_DB_MONITOR_PASSWORD=change-me-db-monitor
MONGO_ROOT_PASSWORD=change-me-mongo-root
PAYFLOW_MONGO_PASSWORD=change-me-mongo-app
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
PAYFLOW_TREASURY_CLIENT_SECRET=change-me-treasury-secret
PAYFLOW_OPS_CLIENT_SECRET=change-me-ops-secret
PAYFLOW_MONITORING_CLIENT_SECRET=change-me-monitoring-secret
# Kafka SASL/SCRAM identities (payflow-app = the application; service principals = extraction-ready ACL matrix)
PAYFLOW_KAFKA_APP_PASSWORD=change-me-kafka-app
PAYFLOW_KAFKA_SERVICE_PASSWORD=change-me-kafka-services
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# Synthetic load-test customers (performance/scripts/provision-perf-users.sh); lab only.
PAYFLOW_PERF_USER_PASSWORD=change-me-perf-user
PAYFLOW_DEMO_USER_PASSWORD=change-me-demo-user

# Optional host-port overrides when the defaults are taken
# PAYFLOW_PG_HOST_PORT=5432
# PAYFLOW_MONGO_HOST_PORT=27017
# PAYFLOW_API_HOST_PORT=8080
# PAYFLOW_KAFKA_HOST_PORT=9092
# PAYFLOW_KEYCLOAK_HOST_PORT=8081   (also changes the token issuer URL)
# PAYFLOW_PROMETHEUS_HOST_PORT=9090
# PAYFLOW_GRAFANA_HOST_PORT=3000
