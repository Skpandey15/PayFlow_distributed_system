{
  "uid": "payflow-kafka",
  "title": "Kafka health",
  "tags": [
    "payflow",
    "wp-03"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Are consumers keeping up? (broker-side lag per group/topic, main topics)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (group, topic) (payflow_kafka_consumer_lag_records{topic!~\".*-(retry|dlt).*\"})",
          "legendFormat": "{{group}} {{topic}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "From committed offsets, so it keeps growing when a consumer is dead (the client metric would vanish).",
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Is the lag monitor itself current? (seconds since last successful read)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(payflow_kafka_lag_monitor_last_success_seconds)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "What is being consumed? (events/s by consumer and outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumer, outcome) (rate(payflow_events_consumed_total[5m]))",
          "legendFormat": "{{consumer}} {{outcome}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "How long does handling an event take? (p99 by consumer)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, consumer) (rate(payflow_events_processing_seconds_bucket{}[5m])))",
          "legendFormat": "{{consumer}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Which failures occur, retryable or permanent? (by category)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (category) (rate(payflow_events_failed_total[5m]))",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "What is being dead-lettered? (by topic and category)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic, category) (increase(payflow_events_dead_lettered_total[15m]))",
          "legendFormat": "{{topic}} {{category}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Is anything stuck in retry topics? (lag on retry/DLT topics)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (group, topic) (payflow_kafka_consumer_lag_records{topic=~\".*-retry.*\"})",
          "legendFormat": "{{group}} {{topic}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    }
  ],
  "links": [
    {
      "title": "PayFlow dashboards",
      "type": "dashboards",
      "tags": [
        "payflow"
      ]
    }
  ]
}
