{
  "uid": "payflow-resilience",
  "title": "Resilience",
  "tags": [
    "payflow",
    "wp-03"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Is a settlement rail circuit open? (1 = in state)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, state) (resilience4j_circuitbreaker_state)",
          "legendFormat": "{{name}} {{state}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "How is the rail answering? (calls by outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rail, outcome) (rate(payflow_settlement_rail_calls_total[5m]))",
          "legendFormat": "{{rail}} {{outcome}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Failure and slow-call rate seen by the breaker",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (resilience4j_circuitbreaker_failure_rate)",
          "legendFormat": "failure {{name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (resilience4j_circuitbreaker_slow_call_rate)",
          "legendFormat": "slow {{name}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Are retries helping? (retry outcomes)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, kind) (rate(resilience4j_retry_calls_total[5m]))",
          "legendFormat": "{{name}} {{kind}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Is a bulkhead saturated? (available permits)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (name) (resilience4j_bulkhead_available_concurrent_calls)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Is intake throttled? (429/503 per policy)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy) (rate(payflow_traffic_rejected_total[1m]))",
          "legendFormat": "{{policy}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6
    }
  ],
  "links": [
