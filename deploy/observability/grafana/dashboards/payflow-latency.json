          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "How fast is the settlement rail? (HTTP client p99 by rail call)",
      "datasource": {
