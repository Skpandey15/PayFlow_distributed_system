          },
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_client_requests_seconds_bucket{}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
